<launch>
    <param name="/use_sim_time" value="false"/>
    <arg name="map_file" default="$(find cartographer_ros)/map/2d.yaml"/>

    <!-- 运行地图服务器，并且加载设置的地图-->
    <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)"/>
        
    <include file="$(find cartographer_ros)/launch/self_backpack_2d_localization.launch" />

    <!-- 运行move_base节点 -->
    <include file="$(find move_base)/launch/use_my_local_planner_carto.launch" />
    <!-- 运行rviz -->
    <node pkg="rviz" type="rviz" name="rviz"  args="-d $(find move_base)/rviz/my_robot_nav.rviz" />

</launch>
