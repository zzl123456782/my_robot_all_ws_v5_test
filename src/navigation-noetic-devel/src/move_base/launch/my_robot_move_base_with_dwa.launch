<launch>
    <node pkg="move_base" type="move_base" respawn="false" name="move_base_node" output="screen" clear_params="true">
        <!-- 规划器类型通常放在参数文件中，或者统一在参数文件中设置 -->
        
        <!-- 加载基础参数 -->
        <!-- <rosparam file="$(find move_base)/param/move_base_params.yaml" command="load" /> -->
        
        <!-- 加载代价地图通用参数 -->
        <rosparam file="$(find move_base)/param/costmap_common_params.yaml" command="load" ns="global_costmap" />
        <rosparam file="$(find move_base)/param/costmap_common_params.yaml" command="load" ns="local_costmap" />
        
        <!-- 加载特定代价地图参数 -->
        <rosparam file="$(find move_base)/param/local_costmap_params.yaml" command="load" />
        <rosparam file="$(find move_base)/param/global_costmap_params.yaml" command="load" />
        
        <!-- 加载规划器参数 -->
        <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/>
        <rosparam file="$(find move_base)/param/dwa_local_planner_params_2.yaml" command="load" />

        <param name="controller_frequency" value="3.0" />
        <param name="update_frequency" value="2.0"/>

        

        <param name="local_costmap/update_frequency" value="8.0" />
        <param name="global_costmap/update_frequency" value="5.0" />
        <param name="local_costmap/width" value="4.0" />
        <param name="local_costmap/height" value="4.0" />
            
    </node>
</launch>